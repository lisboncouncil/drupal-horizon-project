<?php

/**
 * @file
 * Install, update and uninstall functions for the lc_section_partners module.
 */

use Drupal\Core\Config\FileStorage;
use Drupal\Core\Entity\Entity\EntityFormDisplay;
use Drupal\Core\Entity\Entity\EntityViewDisplay;
use Drupal\field\Entity\FieldConfig;
use Drupal\field\Entity\FieldStorageConfig;

/**
 * Implements hook_install().
 *
 * The 'country' vocabulary cannot be a config/install file: older versions of
 * lc_hcommon created it programmatically, and on those sites Drupal would
 * refuse to install a module whose config/install collides with it. It is
 * created here from config/optional when missing. For the same reason
 * field_country does not declare the vocabulary as a config dependency in its
 * YAML; the field is re-saved here so that Drupal records the dependency.
 */
function lc_section_partners_install($is_syncing) {
  if ($is_syncing) {
    return;
  }

  $vocabulary_storage = \Drupal::entityTypeManager()->getStorage('taxonomy_vocabulary');
  if (!$vocabulary_storage->load('country')) {
    $source = new FileStorage(\Drupal::service('extension.list.module')->getPath('lc_section_partners') . '/config/optional');
    $vocabulary_storage->createFromStorageRecord($source->read('taxonomy.vocabulary.country'))->save();
  }

  _lc_section_partners_create_country_terms();

  lc_section_partners_grant_admin_bar(array_keys(\Drupal::moduleHandler()->getModuleList()));

  $field = FieldConfig::loadByName('node', 'partner', 'field_country');
  if ($field) {
    $field->save();
  }
}

/**
 * Populates the 'country' vocabulary with the EU27 countries, if empty.
 */
function _lc_section_partners_create_country_terms() {
  $vid = 'country';

  $entity_type_manager = \Drupal::entityTypeManager();
  if (!$entity_type_manager->getStorage('taxonomy_vocabulary')->load($vid)) {
    return;
  }

  $term_storage = $entity_type_manager->getStorage('taxonomy_term');
  $existing = $term_storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('vid', $vid)
    ->count()
    ->execute();
  if ($existing) {
    return;
  }

  $countries = [
    'Austria',
    'Belgium',
    'Bulgaria',
    'Croatia',
    'Cyprus',
    'Czechia',
    'Denmark',
    'Estonia',
    'Finland',
    'France',
    'Germany',
    'Greece',
    'Hungary',
    'Ireland',
    'Italy',
    'Latvia',
    'Lithuania',
    'Luxembourg',
    'Malta',
    'Netherlands',
    'Poland',
    'Portugal',
    'Romania',
    'Slovakia',
    'Slovenia',
    'Spain',
    'Sweden',
  ];

  foreach ($countries as $weight => $country) {
    $term_storage->create([
      'name' => $country,
      'vid' => $vid,
      'weight' => $weight,
    ])->save();
  }
}

/**
 * Adds the PIC number field to the partner content type.
 */
function lc_section_partners_update_10001() {
  $source = new FileStorage(\Drupal::service('extension.list.module')->getPath('lc_section_partners') . '/config/install');

  if (!FieldStorageConfig::loadByName('node', 'field_pic_number')) {
    FieldStorageConfig::create($source->read('field.storage.node.field_pic_number'))->save();
  }
  if (!FieldConfig::loadByName('node', 'partner', 'field_pic_number')) {
    FieldConfig::create($source->read('field.field.node.partner.field_pic_number'))->save();
  }

  $form_display = EntityFormDisplay::load('node.partner.default');
  if ($form_display && !$form_display->getComponent('field_pic_number')) {
    $form_display->setComponent('field_pic_number', [
      'type' => 'number',
      'weight' => 27,
      'settings' => ['placeholder' => ''],
    ])->save();
  }

  foreach (['default', 'teaser'] as $view_mode) {
    $view_display = EntityViewDisplay::load('node.partner.' . $view_mode);
    if ($view_display && $view_display->getComponent('field_pic_number')) {
      $view_display->removeComponent('field_pic_number')->save();
    }
  }
}
