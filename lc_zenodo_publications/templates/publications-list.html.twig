<div class="publications-list">

  <h2 class="visually-hidden">{{ 'Publications about the project'|t }}</h2>
  <div class="pub-intro well">
    {% trans %}Project publications are originally saved on a Zenodo community.{% endtrans %}
    <a href="{{path_page}}">{% trans %}Access the project's community page to see the details.{% endtrans %}</a>
  </div>

  {% set count = n_pubs %}
  <div class="n-pubs">{% trans %}There is <strong>{{ count }}</strong> publication{% plural count %}There are <strong>{{ count }}</strong> publications{% endtrans %}</div>

  <div class="row">
    {% for publication in publications %}
      <div class="pub-item my-5">

        <h3>
          <a href="https://doi.org/{{publication.doi}}" rel="nofollow">
            {{publication.title}}
          </a>
        </h3>

        <div class="pub-authors">{{ publication.authors | join('; ') | raw }}</div>

        <div class="pub-date">
          {{ 'Publication date:'|t }} {{publication.publication_date}}
          -
          DOI: {{publication.doi}}
        </div>
        <div class="pub-abstract">
          {{publication.description | raw}}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
