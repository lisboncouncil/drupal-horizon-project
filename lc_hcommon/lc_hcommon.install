<?php

/**
 * @file
 * Install, update and uninstall functions for the lc_hcommon module.
 */

use Drupal\menu_link_content\Entity\MenuLinkContent;
use Drupal\node\Entity\Node;

/**
 * Implements hook_install().
 *
 * The 'page' and 'article' content types ship in config/optional, so they
 * already exist when this runs: either created by this module (fresh Drupal
 * 11.4+ site) or pre-existing (site created with an older standard profile).
 */
function lc_hcommon_install($is_syncing) {
  // Content is not created while importing configuration.
  if ($is_syncing) {
    return;
  }

  _lc_hcommon_manage_modules();
  _lc_hcommon_create_empty_nodes();
}

/**
 * Creates the default pages and their menu links.
 *
 * Safe to run more than once: pages whose alias already exists and menu links
 * that already exist are skipped.
 */
function _lc_hcommon_create_empty_nodes() {
  $uuid_about = 'dd944cfe-61b0-4b9b-a34b-9be7cd854d7c';

  $menu_link_storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $about = $menu_link_storage->loadByProperties(['uuid' => $uuid_about]);
  $menu_link_about = reset($about);
  if (!$menu_link_about) {
    $menu_link_about = MenuLinkContent::create([
      'title' => 'About',
      'link' => 'internal:/',
      'menu_name' => 'main',
      'expanded' => TRUE,
      'weight' => 1,
      'uuid' => $uuid_about,
    ]);
    $menu_link_about->save();
  }
  $parent_about = $menu_link_about->getPluginId();

  $pages = [
    'project-description' => [
      'title' => 'Description of the project',
      'path' => '/project-description',
      'menu' => 'main',
      'parent' => $parent_about,
    ],
    'governance' => [
      'title' => 'Governance',
      'path' => '/governance',
      'menu' => 'main',
      'parent' => $parent_about,
    ],
    'contact' => [
      'title' => 'Contact',
      'path' => '/contact',
      'menu' => 'main',
      'parent' => NULL,
      'weight' => 10,
    ],
    'opendata' => [
      'title' => 'Open data',
      'path' => '/open-data',
      'menu' => 'footer',
      'parent' => NULL,
    ],
    'outcomes' => [
      'title' => 'Outcomes',
      'path' => '/outcomes',
      'menu' => 'main',
      'parent' => NULL,
      'weight' => 3,
    ],
  ];

  $alias_repository = \Drupal::service('path_alias.repository');
  $k = 0;

  foreach ($pages as $page) {
    $k++;

    if ($alias_repository->lookupByAlias($page['path'], 'en') || $alias_repository->lookupByAlias($page['path'], 'und')) {
      continue;
    }

    $node = Node::create([
      'type' => 'page',
      'title' => $page['title'],
      'uid' => 1,
      'status' => 1,
      'path' => ['alias' => $page['path']],
    ]);
    $node->save();

    _lc_hcommon_add_menu_link($page['title'], $page['path'], $page['menu'], $page['weight'] ?? $k, $page['parent']);
  }

  // The contact page is linked from the footer too.
  _lc_hcommon_add_menu_link($pages['contact']['title'], $pages['contact']['path'], 'footer', 10, NULL);
}

/**
 * Adds a menu link unless the same link already exists in the menu.
 */
function _lc_hcommon_add_menu_link($title, $path, $menu_name, $weight, $parent) {
  $storage = \Drupal::entityTypeManager()->getStorage('menu_link_content');
  $uri = 'internal:' . $path;

  $existing = $storage->getQuery()
    ->accessCheck(FALSE)
    ->condition('menu_name', $menu_name)
    ->condition('link.uri', $uri)
    ->count()
    ->execute();
  if ($existing) {
    return;
  }

  $storage->create([
    'title' => $title,
    'link' => $uri,
    'menu_name' => $menu_name,
    'expanded' => TRUE,
    'weight' => $weight,
    'parent' => $parent,
  ])->save();
}

/**
 * Pre-install or uninstall some contrib modules.
 */
function _lc_hcommon_manage_modules() {
  $enable = [];

  $disable = [
    'contact',
  ];

  $module_handler = \Drupal::moduleHandler();

  $enable = array_filter($enable, fn($module) => !$module_handler->moduleExists($module));
  if ($enable) {
    \Drupal::service('module_installer')->install($enable);
  }

  $disable = array_filter($disable, fn($module) => $module_handler->moduleExists($module));
  if ($disable) {
    \Drupal::service('module_installer')->uninstall($disable);
  }
}
